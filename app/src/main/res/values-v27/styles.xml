<resources>
    <style name="AppTheme" parent="AppThemeLight" />
    <style name="AppThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#32715F</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F7F8F4</item>
        <item name="android:navigationBarColor">#F7F8F4</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F7F8F4</item>
    </style>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#99D5B8</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#111A16</item>
        <item name="android:navigationBarColor">#111A16</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#111A16</item>
    </style>
</resources>